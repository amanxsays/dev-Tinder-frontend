{
  "appId": "com.amanxsays.devtinder",
  "appName": "DevTinder",
  "webDir": "dist-android",
  "server": { "hostname": "localhost", "androidScheme": "https", "cleartext": false },
  "android": { "allowMixedContent": false, "webContentsDebuggingEnabled": false },
  "plugins": {
    "SystemBars": { "insetsHandling": "disable", "style": "DARK" },
    "CapacitorHttp": { "enabled": false },
    "CapacitorCookies": { "enabled": false },
    "SplashScreen": { "launchAutoHide": true, "backgroundColor": "#0c1520", "showSpinner": false }
  }
}
